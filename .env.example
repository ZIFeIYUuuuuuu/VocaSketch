# VocaSketch Python v2 后端配置。
# 默认 mock/offline，不会调用真实外部模型。
VOCASKETCH_PROVIDER_PROFILE=mock
VOCASKETCH_PROVIDER_ALLOW_LIVE_REQUESTS=0

# 本地数据目录：jobs/events/assets 会写到这里。
VOCASKETCH_BACKEND_DATA_DIR=backend/data

# 可选：显式覆盖后端监听地址。
VOCASKETCH_BACKEND_HOST=127.0.0.1
VOCASKETCH_BACKEND_PORT=8000

# 文本模型网关：intent / visual brief / image prompt。
# 只有 VOCASKETCH_PROVIDER_PROFILE=openai 且 VOCASKETCH_PROVIDER_ALLOW_LIVE_REQUESTS=1 时才会使用。
VOCASKETCH_OPENAI_API_BASE_URL=
VOCASKETCH_OPENAI_API_KEY=
VOCASKETCH_OPENAI_RESPONSE_MODEL=
VOCASKETCH_OPENAI_TIMEOUT_SECONDS=30

# 生图模型网关：preview / final image。
# 如果和文本模型不是同一个网关，请在这里单独填写生图网关和生图 API key。
VOCASKETCH_OPENAI_IMAGE_API_BASE_URL=
VOCASKETCH_OPENAI_IMAGE_API_KEY=
VOCASKETCH_OPENAI_IMAGE_MODEL=
VOCASKETCH_OPENAI_IMAGE_TIMEOUT_SECONDS=120

# 可选：模型生成干净线稿。
# 用途：final 彩色图 -> clean lineart -> 向量化/stroke 排序 -> 后端过程视频。
# 必须同时打开 live request 和下面的显式开关才会联网。
VOCASKETCH_ENABLE_MODEL_LINEART=0
VOCASKETCH_LINEART_PROVIDER=gemini
VOCASKETCH_LINEART_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VOCASKETCH_LINEART_API_KEY=
VOCASKETCH_LINEART_MODEL=

# 可选：后端生成过程 MP4。默认开启；自动化测试可设为 0 降低耗时。
VOCASKETCH_RENDER_PROCESS_VIDEO=1

# 前端配置：默认只连接 Python v2。
VITE_API_V2_BASE_URL=http://localhost:8000/api/v2
VITE_ENABLE_V2_VOICE_DRAWING=true

# 旧 Node/V1 后端已从正常流程移除。仅历史对照时才打开。
# VITE_ENABLE_LEGACY_V1_BACKEND=true
# VITE_LEGACY_API_BASE_URL=http://localhost:4000/api/v1
