# VocaSketch 前端运行配置。
# 默认只连接 Python backend 的 v2 Drawing Job API；旧 Node/V1 后端已从正常流程移除。

# Python 后端 v2 API：绘画任务、资产内容、绘画过程播放都走这里。
VITE_API_V2_BASE_URL=http://localhost:8000/api/v2

# 语音默认使用浏览器 Web Speech，识别文本会直接提交给 Python v2。
VITE_ENABLE_V2_VOICE_DRAWING=true

# 仅作旧功能回滚/对照时才打开。默认不要填写，也不要启动旧 Node/V1 后端。
# VITE_ENABLE_LEGACY_V1_BACKEND=true
# VITE_LEGACY_API_BASE_URL=http://localhost:4000/api/v1
